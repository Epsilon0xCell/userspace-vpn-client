# EXAMPLE PROFILE TEMPLATE. NOT A REAL PROFILE. DO NOT USE AS IS.
# This file shows the shape of an OpenVPN client profile that works with
# run.sh. Replace every placeholder with values from your own provider.
# Never commit a real profile: this repo ignores *.ovpn for that reason.

client
dev tun
proto tcp
remote vpn.example.invalid 443
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth SHA256
cipher AES-256-CBC
data-ciphers AES-256-CBC:AES-256-GCM
ignore-unknown-option data-ciphers-fallback
data-ciphers-fallback AES-256-CBC
comp-lzo no
verb 3

<ca>
# PLACEHOLDER: paste your provider CA certificate here.
# (Intentionally left empty in this template.)
</ca>

<cert>
# PLACEHOLDER: paste your client certificate here.
</cert>

<key>
# PLACEHOLDER: paste your client key here.
</key>

<tls-crypt>
# PLACEHOLDER: paste the tls-crypt static key here.
</tls-crypt>
